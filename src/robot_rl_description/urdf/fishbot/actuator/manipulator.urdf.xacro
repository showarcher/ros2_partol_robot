<?xml version="1.0"?>
<!-- 左右双臂：两主关节 + 两指平行夹爪 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find robot_rl_description)/urdf/fishbot/common/common_inertia.xacro"/>

    <!-- 肩部安装座，嵌入躯干侧壁 -->
    <xacro:property name="shoulder_socket_length" value="0.040"/>
    <xacro:property name="shoulder_socket_radius" value="0.024"/>
    <xacro:property name="shoulder_socket_collision_radius" value="0.016"/>
    <xacro:property name="shoulder_socket_collision_length" value="0.024"/>

    <!-- 两段主臂 -->
    <xacro:property name="upper_arm_length" value="0.074"/>
    <xacro:property name="upper_arm_radius" value="0.013"/>
    <xacro:property name="forearm_length" value="0.062"/>
    <xacro:property name="forearm_radius" value="0.012"/>

    <!-- 两指夹爪 -->
    <xacro:property name="gripper_base_length" value="0.022"/>
    <xacro:property name="gripper_base_radius" value="0.013"/>
    <xacro:property name="finger_length" value="0.034"/>
    <xacro:property name="finger_width" value="0.007"/>
    <xacro:property name="finger_height" value="0.010"/>
    <xacro:property name="finger_opening" value="0.014"/>
    <xacro:property name="finger_travel" value="0.010"/>

    <xacro:macro name="arm_segment_link" params="name length mass material gazebo_material radius">
        <link name="${name}">
            <visual>
                <origin xyz="${length/2} 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="${material}"/>
            </visual>
            <visual>
                <origin xyz="0.008 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${radius + 0.002}"/>
                </geometry>
                <material name="${material}"/>
            </visual>
            <visual>
                <origin xyz="${length - 0.008} 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${radius + 0.002}"/>
                </geometry>
                <material name="${material}"/>
            </visual>
            <collision>
                <origin xyz="${length/2} 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${mass}" r="${radius}" h="${length}"/>
        </link>
        <gazebo reference="${name}">
            <material>${gazebo_material}</material>
            <selfCollide>false</selfCollide>
            <!-- Position-controlled arms must not fall before their controller
                 receives its first trajectory during simulator startup. -->
            <gravity>false</gravity>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="gripper_base_link_macro" params="name">
        <link name="${name}">
            <visual>
                <origin xyz="0.010 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${gripper_base_radius}" length="${gripper_base_length}"/>
                </geometry>
                <material name="black_material"/>
            </visual>
            <visual>
                <origin xyz="0.016 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="0.006" length="0.010"/>
                </geometry>
                <material name="cyan_material"/>
            </visual>
            <collision>
                <origin xyz="0.010 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${gripper_base_radius}" length="${gripper_base_length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="0.026" r="${gripper_base_radius}" h="${gripper_base_length}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="finger_link" params="name">
        <link name="${name}">
            <visual>
                <origin xyz="0.017 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${finger_length} ${finger_width} ${finger_height}"/>
                </geometry>
                <material name="silver_material"/>
            </visual>
            <visual>
                <origin xyz="0.032 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.006 ${finger_width * 1.1} ${finger_height * 1.1}"/>
                </geometry>
                <material name="cyan_material"/>
            </visual>
            <collision>
                <origin xyz="0.017 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${finger_length} ${finger_width} ${finger_height}"/>
                </geometry>
            </collision>
            <xacro:box_inertia m="0.010" l="${finger_length}" w="${finger_width}" h="${finger_height}"/>
        </link>
        <gazebo reference="${name}">
            <material>Gazebo/DarkGrey</material>
            <selfCollide>false</selfCollide>
            <gravity>false</gravity>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="arm_macro" params="prefix side_sign">
        <link name="${prefix}_shoulder_socket_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${shoulder_socket_radius}" length="${shoulder_socket_length}"/>
                </geometry>
                <material name="black_material"/>
            </visual>
            <visual>
                <origin xyz="0.006 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="0.017" length="0.034"/>
                </geometry>
                <material name="dark_gray_material"/>
            </visual>
            <visual>
                <origin xyz="0.017 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="0.010" length="0.006"/>
                </geometry>
                <material name="cyan_material"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 1.57079 0"/>
                <geometry>
                    <cylinder radius="${shoulder_socket_collision_radius}" length="${shoulder_socket_collision_length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="0.032" r="${shoulder_socket_collision_radius}" h="${shoulder_socket_collision_length}"/>
        </link>
        <joint name="${prefix}_arm_mount_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_shoulder_socket_link"/>
            <!-- 肩座顶面与躯干顶面齐平，并向躯干内侧贴合 -->
            <origin xyz="0.018 ${side_sign * 0.12} 0.066" rpy="0 0 ${side_sign * -0.04}"/>
        </joint>
        <gazebo reference="${prefix}_shoulder_socket_link">
            <material>Gazebo/DarkGrey</material>
            <selfCollide>false</selfCollide>
        </gazebo>

        <joint name="${prefix}_shoulder_joint" type="revolute">
            <parent link="${prefix}_shoulder_socket_link"/>
            <child link="${prefix}_upper_arm_link"/>
            <origin xyz="${shoulder_socket_length / 2} 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-0.95" upper="1.05" effort="3.5" velocity="1.2"/>
            <dynamics damping="0.20" friction="0.04"/>
        </joint>
        <xacro:arm_segment_link name="${prefix}_upper_arm_link" length="${upper_arm_length}" mass="0.034" material="silver_material" gazebo_material="Gazebo/Silver" radius="${upper_arm_radius}"/>

        <joint name="${prefix}_elbow_joint" type="revolute">
            <parent link="${prefix}_upper_arm_link"/>
            <child link="${prefix}_forearm_link"/>
            <origin xyz="${upper_arm_length} 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.10" upper="1.10" effort="2.8" velocity="1.2"/>
            <dynamics damping="0.18" friction="0.035"/>
        </joint>
        <xacro:arm_segment_link name="${prefix}_forearm_link" length="${forearm_length}" mass="0.028" material="silver_material" gazebo_material="Gazebo/Silver" radius="${forearm_radius}"/>

        <xacro:gripper_base_link_macro name="${prefix}_gripper_base_link"/>
        <joint name="${prefix}_gripper_mount_joint" type="fixed">
            <parent link="${prefix}_forearm_link"/>
            <child link="${prefix}_gripper_base_link"/>
            <origin xyz="${forearm_length} 0 0" rpy="0 0 0"/>
        </joint>
        <gazebo reference="${prefix}_gripper_base_link">
            <material>Gazebo/Black</material>
            <selfCollide>false</selfCollide>
            <gravity>false</gravity>
        </gazebo>

        <joint name="${prefix}_gripper_left_finger_joint" type="prismatic">
            <parent link="${prefix}_gripper_base_link"/>
            <child link="${prefix}_gripper_left_finger_link"/>
            <origin xyz="0.009 ${finger_opening} 0.0" rpy="0 0 0"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0.0" upper="${finger_travel}" effort="4.0" velocity="0.05"/>
            <dynamics damping="0.12" friction="0.02"/>
        </joint>
        <xacro:finger_link name="${prefix}_gripper_left_finger_link"/>
        <gazebo reference="${prefix}_gripper_left_finger_link">
            <material>Gazebo/DarkGrey</material>
            <mu1>2.0</mu1>
            <mu2>2.0</mu2>
            <kp>150000.0</kp>
            <kd>1.0</kd>
            <selfCollide>false</selfCollide>
            <gravity>false</gravity>
        </gazebo>

        <joint name="${prefix}_gripper_right_finger_joint" type="prismatic">
            <parent link="${prefix}_gripper_base_link"/>
            <child link="${prefix}_gripper_right_finger_link"/>
            <origin xyz="0.009 ${-finger_opening} 0.0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0.0" upper="${finger_travel}" effort="4.0" velocity="0.05"/>
            <dynamics damping="0.12" friction="0.02"/>
        </joint>
        <xacro:finger_link name="${prefix}_gripper_right_finger_link"/>
        <gazebo reference="${prefix}_gripper_right_finger_link">
            <material>Gazebo/DarkGrey</material>
            <mu1>2.0</mu1>
            <mu2>2.0</mu2>
            <kp>150000.0</kp>
            <kd>1.0</kd>
            <selfCollide>false</selfCollide>
            <gravity>false</gravity>
        </gazebo>
    </xacro:macro>
</robot>
