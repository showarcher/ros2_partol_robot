<?xml version="1.0"?>
<!-- 机器人camera相机模块 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find robot_rl_description)/urdf/fishbot/common/common_inertia.xacro"/>
    
    <!-- 1.基本模型添加 -->
    <xacro:macro name="camera_xacro" params="xyz">
        <link name="camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.024 0.12 0.024"/>
                </geometry>
                <material name="black_material"/>
            </visual>

            <!-- 2.碰撞属性collision添加 -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.024 0.12 0.024"/>
                </geometry>
                <material name="black_material"/>
            </collision>

            <!-- 3.质量和惯性属性添加 -->
            <xacro:box_inertia m="0.1" w="0.024" l="0.12" h="0.024" />
        </link>

        <!-- 4.深度相机辅助link -->
        <link name="camera_optical_link"></link>

        <!-- 5.1 相机与底盘固定关节 -->
        <joint name="camera_joint" type="fixed">
            <parent link="base_link"/>
            <child link="camera_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>

        <!-- 5.2 相机与辅助坐标系固定关节 -->
        <joint name="camera_optical_joint" type="fixed">
            <parent link="camera_link"/>
            <child link="camera_optical_link"/>
            <!-- 通过旋转修正坐标系，使其符合 ROS 相机标准坐标系 -->
            <origin xyz="0 0 0" rpy="${-pi/2} 0.0 ${-pi/2}"/>
        </joint>

        <!-- 6.gazebo中显示，扩展URDF文件 -->
        <gazebo reference="camera_link">
            <material>Gazebo/Black</material>
        </gazebo>

        <!-- 前脸面板，只做视觉，不增加碰撞，便于挂双眼图案 -->
        <link name="camera_face_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.004 0.056 0.020"/>
                </geometry>
                <material name="black_material"/>
            </visual>
            <xacro:box_inertia m="0.002" w="0.004" l="0.056" h="0.020"/>
        </link>
        <joint name="camera_face_joint" type="fixed">
            <parent link="camera_link"/>
            <child link="camera_face_link"/>
            <origin xyz="0.014 0 0" rpy="0 0 0"/>
        </joint>
        <gazebo reference="camera_face_link">
            <material>Gazebo/Black</material>
        </gazebo>

        <link name="camera_eye_left_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.0045"/>
                </geometry>
                <material name="cyan_material"/>
            </visual>
            <xacro:sphere_inertia m="0.0008" r="0.0045"/>
        </link>
        <joint name="camera_eye_left_joint" type="fixed">
            <parent link="camera_face_link"/>
            <child link="camera_eye_left_link"/>
            <origin xyz="0.003 0.011 0.002" rpy="0 0 0"/>
        </joint>
        <gazebo reference="camera_eye_left_link">
            <material>Gazebo/Cyan</material>
        </gazebo>

        <link name="camera_eye_right_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.0045"/>
                </geometry>
                <material name="cyan_material"/>
            </visual>
            <xacro:sphere_inertia m="0.0008" r="0.0045"/>
        </link>
        <joint name="camera_eye_right_joint" type="fixed">
            <parent link="camera_face_link"/>
            <child link="camera_eye_right_link"/>
            <origin xyz="0.003 -0.011 0.002" rpy="0 0 0"/>
        </joint>
        <gazebo reference="camera_eye_right_link">
            <material>Gazebo/Cyan</material>
        </gazebo>

    </xacro:macro>
</robot>
